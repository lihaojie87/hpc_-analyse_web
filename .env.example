HPC_APP_NAME=HPC Performance Platform
HPC_ENV=dev
HPC_DATABASE_URL=sqlite+aiosqlite:///./hpc.db
HPC_TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db
HPC_REDIS_URL=redis://localhost:6379/0
# Required: generate with `openssl rand -base64 48`; never commit a real secret.
HPC_JWT_SECRET=
HPC_JWT_ACCESS_TTL=900
HPC_JWT_REFRESH_TTL=604800
HPC_CORS_ORIGINS=http://localhost:5173
HPC_LOGIN_MAX_FAILURES=5
HPC_LOGIN_LOCK_SECONDS=900
HPC_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Optional in dev/test only; use a strong secret (12+ chars) when bootstrapping.
HPC_BOOTSTRAP_ADMIN_PASSWORD=
